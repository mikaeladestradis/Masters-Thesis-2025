#Modified 2d-model - created to be non-dimensionalised, 
#dimensionless parameters x, T, w  

dx/dT = (I_stim - m_inf(x)*(x-E_Na) - g_slow*w*(x-E_k) - g_leak*(x-E_leak))
dw/dT = (eps)*((w_inf(x)-w)/tau_w(x))
param g_slow=1, g_leak=0.1
param E_Na=0.5, E_leak=-0.7 , E_k=-1
param eps = 0.015

#we set k_v =100mV, to start make it equal to the Prescot dimensional model (ie k_t = 100)
param k_v=100
param k_T=0.1

#these are the 'good' intial conditions - taken from the Prescott model
x(0)=-0.7
w(0)=0.000025

#now we work through the cosh and tanh, these are the same as the model we are 
#working off, since tanh and cosh are dimensionless functions. 
m_inf(x) = 0.5*(1 + tanh((k_v*x - beta_m) / gamma_m))

w_inf(x) = 0.5*(1 + tanh((k_v*x - beta_w) / gamma_w))

tau_w(x) = 1/ cosh((k_v*x - beta_w) / (2* gamma_w))

param beta_m= -1.2, gamma_m= 18, gamma_w= 10

#note: I_stim is varied to produce bifurcation diagrams, start generally with I_stim = 0, 
param I_stim=0.04
# and then increase. Also, beta_w is varied to produce the three excitabolity types: uncomment the type you want
#note that types 2 and 3 can interchange when you increase the stimulus to a large enough value. 
#type 1
#param beta_w=0

#type 2
#param beta_w=-13

#type 3
param beta_w=-21


# following parameters control duration of simulation and axes of default plot
@ total=10000,dt=0.001,xlo=-0.1,xhi=0.3,ylo=-0.9,yhi=0.5,xp=w,yp=x
@ meth=stiff
@ MAXSTOR=100000000

done